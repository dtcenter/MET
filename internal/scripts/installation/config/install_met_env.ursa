export MET_PYTHON_LD="-L${MET_PYTHON}/lib/python3.14/config-3.14-x86_64-linux-gnu -L${MET_PYTHON}/lib -lpython3.14 -lpthread -ldl  -lutil -lm"
export ADDTL_DIR=/usr/lib64
export EXTERNAL_LIBS=${TEST_BASE}/external_libs/
