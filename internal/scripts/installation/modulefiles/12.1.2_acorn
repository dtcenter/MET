#%Module######################################################################
##
##      Model Evaluation Tools
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the Model Evaluation Tools v12.1.2
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

# The intel compiler is required to run MET

module use /apps/ops/para/libs/modulefiles/compiler/intel/19.1.3.304/
module load intel
module use /apps/dev/lmodules/intel/19.1.3.304
module load ve/evs/2.1
module load netcdf/4.7.4
module load hdf5/1.10.6
#NOTE: bufr/12.3.0 will be used on WCOSS2, but is unavailable on Acorn for testing
module load bufr/12.1.0
module load zlib/1.2.11
module load jasper/2.0.25
module load libpng/1.6.37
module load gsl/2.7
module load g2c/2.2.0
module load proj/7.1.0
module use /apps/dev/lmodules/intel/19.1.3.304/
module load atlas/0.44.1
module load eckit/1.28.3

set base /apps/sw_review/emc/MET/12.1.2
set ver  12.1.2
set share $base/share/met
set lib_base $base

prepend-path PATH $base/bin

setenv METversion V$ver
setenv MET_ROOT $base
#setenv MET_PYTHON_EXE /apps/dev/ve/intel/19.1.3.304/python/3.12.0/evs/2.1/bin/python

