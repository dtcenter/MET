#%Module######################################################################
##
##      Model Evaluation Tools
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the Model Evaluation Tools v13.0.0
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

# The intel compiler is required to run MET
module load ncarenv/25.10
module load intel/2025.2.1
module load cmake/3.31.8
module load proj/9.7.0

set base /glade/work/dtcrt/METplus/casper/components/MET/installations/13.0.0
set ver  13.0.0
set share $base/share/met

prepend-path PATH $base/bin:/glade/work/dtcrt/METplus/casper/components/MET/installations/13.0.0/external_libs/bin:/glade/work/dtcrt/METplus/casper/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

setenv HDF5_USE_FILE_LOCKING FALSE
setenv MET_PYTHON_EXE /glade/work/dtcrt/METplus/casper/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin/python3

setenv METversion V$ver
