#%Module######################################################################
##
##      Model Evaluation Tools
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the Model Evaluation Tools v12.1.0
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

# The intel compiler is required to run MET
prereq intel/2024.2.1

set base /contrib/met
set ver  12.1.0
set share $base/$ver/share/met
set lib_base $base/12.1.0
setenv MET_ROOT $base/$ver

prepend-path PATH $base/$ver/bin:$lib_base/external_libs/bin:/scratch3/BMC/dtc/METplus/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

