#%Module######################################################################
##
##      Model Evaluation Tools
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the Model Evaluation Tools v13.0.0
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

prereq spack-managed-x86-64_v3
prereq intel-oneapi-compilers/2025.3.1

set base /apps/contrib/MET
set ver 13.0.0
set share $base/$ver/share/met
set lib_base $base/13.0.0
setenv MET_ROOT $base/$ver/MET-13.0.0

prepend-path PATH $base/$ver/bin:$lib_base/external_libs/bin:/work/noaa/ovp/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

#setenv MET_PYTHON_EXE /work/noaa/ovp/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin/python