#%Module######################################################################
##
##      Model Evaluation Tools
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the Model Evaluation Tools v12.0.0
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

prereq intel/2024.2.1

set base /contrib/met/12.0.2
set ver 12.0.2
set share $base/share/met
setenv MET_ROOT $base/$ver/MET-12.0.2

prepend-path PATH $base/bin:$base/external_libs/bin:/mnt/lfs5/HFIP/dtc-hurr/METplus/miniconda/miniconda3/envs/metplus_v5.1_py3.10/bin

setenv MET_PYTHON_EXE /mnt/lfs5/HFIP/dtc-hurr/METplus/miniconda/miniconda3/envs/metplus_v5.1_py3.10/bin/python

