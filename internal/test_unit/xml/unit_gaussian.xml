<?xml version="1.0"?>
<!DOCTYPE met_test [
  <!ENTITY MET_BIN        "${MET_BASE}/../../bin">
  <!ENTITY TEST_DIR       "${MET_TEST_BASE}">
  <!ENTITY INPUT_DIR      "${MET_TEST_INPUT}">
  <!ENTITY OUTPUT_DIR     "${MET_TEST_OUTPUT}">

  <!ENTITY DATA_DIR_GAUSS "&INPUT_DIR;/gaussian">
  <!ENTITY DATA_DIR_MODEL "&INPUT_DIR;/model_data">
]>

<!-- Requires: None -->

<met_test>

  <test_dir>&TEST_DIR;</test_dir>
  <exit_on_fail>true</exit_on_fail>

  <test name="Gaussian_GRIB1">
    <exec>&MET_BIN;/plot_data_plane</exec>
    <param> \
      &DATA_DIR_GAUSS;/grib1/gaussian.grib \
      &OUTPUT_DIR;/gaussian/gaussian_grib1.ps \
      'name="T"; level="R001";'
    </param>
    <output>
      <exist>&OUTPUT_DIR;/gaussian/gaussian_grib1.ps</exist>
    </output>
  </test>

  <!-- MET #1257: Regrid to a Gaussian grid and write NetCDF so the truth comparison pins the longitude values -->

  <test name="Gaussian_regrid_lon_spacing">
    <exec>&MET_BIN;/regrid_data_plane</exec>
    <param> \
      &DATA_DIR_MODEL;/grib2/gfs/gfs.0p25.2022092400.f024.grib2 \
      &DATA_DIR_GAUSS;/grib1/gaussian.grib \
      &OUTPUT_DIR;/gaussian/gaussian_regrid_lon_spacing.nc \
      -field 'name="TMP"; level="Z2";' \
      -method NEAREST -width 1 \
      -v 1
    </param>
    <output>
      <grid_nc>&OUTPUT_DIR;/gaussian/gaussian_regrid_lon_spacing.nc</grid_nc>
    </output>
  </test>

  <!-- MET #3586: A thinned or reduced grid has no fixed row length, so its grid definition
       section stores the "not applicable" marker in place of the number of points along a
       parallel.  MET used to take that marker for a real grid dimension and read far past
       the end of the record.  The four tests below cover both GRIB editions, with the
       reduced record either defining the file grid or merely present in it. -->

  <!-- Reject the reduced Gaussian record that defines the GRIB1 file grid -->

  <test name="Gaussian_GRIB1_reduced">
    <exec>&MET_BIN;/plot_data_plane</exec>
    <retval>1</retval>
    <param> \
      &DATA_DIR_GAUSS;/grib1/reduced_gaussian.grib \
      &OUTPUT_DIR;/gaussian/reduced_gaussian_grib1.ps \
      'name="T"; level="R001";' \
      -v 1
    </param>
    <output>
      <not_exist>&OUTPUT_DIR;/gaussian/reduced_gaussian_grib1.ps</not_exist>
    </output>
  </test>

  <!-- Skip the reduced Gaussian record and read the GRIB1 record that can be read -->

  <test name="Gaussian_GRIB1_mixed_reduced">
    <exec>&MET_BIN;/plot_data_plane</exec>
    <param> \
      &DATA_DIR_GAUSS;/grib1/mixed_reduced_gaussian.grib \
      &OUTPUT_DIR;/gaussian/mixed_reduced_gaussian_grib1.ps \
      'name="LAND"; level="L0";' \
      -v 1
    </param>
    <output>
      <ps>&OUTPUT_DIR;/gaussian/mixed_reduced_gaussian_grib1.ps</ps>
    </output>
  </test>

  <!-- Reject the reduced Gaussian record that defines the GRIB2 file grid -->

  <test name="Gaussian_GRIB2_reduced">
    <exec>&MET_BIN;/plot_data_plane</exec>
    <retval>1</retval>
    <param> \
      &DATA_DIR_GAUSS;/grib2/reduced_gaussian.grib2 \
      &OUTPUT_DIR;/gaussian/reduced_gaussian_grib2.ps \
      'name="PrecipFlag"; level="L0";' \
      -v 1
    </param>
    <output>
      <not_exist>&OUTPUT_DIR;/gaussian/reduced_gaussian_grib2.ps</not_exist>
    </output>
  </test>

  <!-- Skip the reduced Gaussian record and read the GRIB2 record that can be read -->

  <test name="Gaussian_GRIB2_mixed_reduced">
    <exec>&MET_BIN;/plot_data_plane</exec>
    <param> \
      &DATA_DIR_GAUSS;/grib2/mixed_reduced_gaussian.grib2 \
      &OUTPUT_DIR;/gaussian/mixed_reduced_gaussian_grib2.ps \
      'name="PrecipFlag"; level="L0";' \
      -v 1
    </param>
    <output>
      <ps>&OUTPUT_DIR;/gaussian/mixed_reduced_gaussian_grib2.ps</ps>
    </output>
  </test>

</met_test>
