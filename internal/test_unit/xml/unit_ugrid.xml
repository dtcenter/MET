<?xml version="1.0"?>
<!DOCTYPE met_test [
  <!ENTITY MET_BIN        "${MET_BASE}/../../bin">
  <!ENTITY TEST_DIR       "${MET_TEST_BASE}">
  <!ENTITY INPUT_DIR      "${MET_TEST_INPUT}">
  <!ENTITY OUTPUT_DIR     "${MET_TEST_OUTPUT}">

  <!ENTITY CONFIG_DIR     "&TEST_DIR;/config">
  <!ENTITY DATA_DIR_MODEL "&INPUT_DIR;/model_data">
  <!ENTITY DATA_DIR_UGRID "&INPUT_DIR;/ugrid_data">
  <!ENTITY DATA_DIR_OBS   "&INPUT_DIR;/obs_data">
  <!ENTITY DATA_DIR_CLIMO "&INPUT_DIR;/climatology_data">
]>

<!-- Requires: unit_ascii2nc.xml unit_pb2nc.xml -->

<met_test>

  <!--                                    -->
  <!--  grid_stat                         -->
  <!--                                    -->

  <test_dir>&TEST_DIR;</test_dir>
  <exit_on_fail>true</exit_on_fail>

  <test name="grid_stat_ugrid_mpas_out_to_grid">
    <exec>&MET_BIN;/grid_stat</exec>
    <env>
      <pair><name>OUTPUT_PREFIX</name>   <value>UGRID_MPAS_OUT_TO_GRID</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/mpasout.2012-04-09_12.00.00_reduced.nc \
      &DATA_DIR_MODEL;/grib2/gfsanl/gfsanl_4_20120409_1200_000.grb2 \
      &CONFIG_DIR;/GridStatConfig_ugrid_mpas \
      -outdir &OUTPUT_DIR;/grid_stat_ugrid -v 1
    </param>
    <output>
      <stat>&OUTPUT_DIR;/grid_stat_ugrid/grid_stat_UGRID_MPAS_OUT_TO_GRID_120000L_20120409_120000V.stat</stat>
      <exist>&OUTPUT_DIR;/grid_stat_ugrid/grid_stat_UGRID_MPAS_OUT_TO_GRID_120000L_20120409_120000V_pairs.nc</exist>
    </output>
  </test>

  <test name="grid_stat_ugrid_mpas_diag">
    <exec>&MET_BIN;/grid_stat</exec>
    <env>
      <pair><name>CLIMO_MEAN_FILE</name> <value>&DATA_DIR_CLIMO;/NCEP_2.5deg/pgba_mean.19590415</value></pair>
      <pair><name>OUTPUT_PREFIX</name>   <value>UGRID_MPAS_DIAG</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2012-04-09_12.00.00_reduced.nc \
      &DATA_DIR_UGRID;/mpas/mpasout.2012-04-09_12.00.00_reduced.nc \
      &CONFIG_DIR;/GridStatConfig_ugrid_mpas_diag \
      -outdir &OUTPUT_DIR;/grid_stat_ugrid -v 1
    </param>
    <output>
      <stat>&OUTPUT_DIR;/grid_stat_ugrid/grid_stat_UGRID_MPAS_DIAG_120000L_20120409_120000V.stat</stat>
      <exist>&OUTPUT_DIR;/grid_stat_ugrid/grid_stat_UGRID_MPAS_DIAG_120000L_20120409_120000V_pairs.nc</exist>
    </output>
  </test>


  <!--                                    -->
  <!--                                    -->
  <!--  point_stat                        -->
  <!--                                    -->

  <test name="point_stat_ugrid_mpas_diag">
    <exec>&MET_BIN;/point_stat</exec>
    <env>
      <pair><name>BEG_DS</name>         <value>-1800</value></pair>
      <pair><name>END_DS</name>         <value>1800</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_MPAS_DIAG_TEMP</value></pair>
      <pair><name>CONFIG_DIR</name>     <value>&CONFIG_DIR;</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2025-05-18_12.00.00.9506.OK.nc \
      &DATA_DIR_OBS;/point_obs/gdas1.20250518.t12z.prepbufr_modified.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_mpas_diag \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 1 
    </param>
    <output>
      <stat>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_MPAS_DIAG_TEMP_120000L_20250518_120000V.stat</stat>
    </output>
  </test>

  <test name="point_stat_ugrid_mpas_out">
    <exec>&MET_BIN;/point_stat</exec>
    <env>
      <pair><name>BEG_DS</name>         <value>-1800</value></pair>
      <pair><name>END_DS</name>         <value>1800</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_MPAS_OUT_TEMP</value></pair>
      <pair><name>CONFIG_DIR</name>     <value>&CONFIG_DIR;</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/mpasout.2012-04-09_12.00.00_reduced.nc \
      &OUTPUT_DIR;/pb2nc/gdas1.20120409.t12z.prepbufr.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_mpas_out \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 1 
    </param>
    <output>
      <stat>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_MPAS_OUT_TEMP_120000L_20120409_120000V.stat</stat>
    </output>
  </test>

  <test name="point_stat_ugrid_mpas_config">
    <exec>&MET_BIN;/point_stat</exec>
    <env>
      <pair><name>BEG_DS</name>         <value>-1800</value></pair>
      <pair><name>END_DS</name>         <value>1800</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_MPAS_CFG_OUT_TEMP</value></pair>
      <pair><name>CONFIG_DIR</name>     <value>&CONFIG_DIR;</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/mpasout.2012-04-09_12.00.00_reduced.nc \
      &OUTPUT_DIR;/pb2nc/gdas1.20120409.t12z.prepbufr.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_no_dataset \
      -ugrid_config ${MET_BASE}/config/UGridConfig_mpas \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 1 
    </param>
    <output>
      <stat>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_MPAS_CFG_OUT_TEMP_120000L_20120409_120000V.stat</stat>
    </output>
  </test>

  <test name="point_stat_ugrid_lfric_pressure_levels">
    <exec>&MET_BIN;/point_stat</exec>
    <env>
      <pair><name>BEG_DS</name>         <value>-180000</value></pair>
      <pair><name>END_DS</name>         <value>180000</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_LFRIC_PRESSURE_LEVELS</value></pair>
      <pair><name>CONFIG_DIR</name>     <value>&CONFIG_DIR;</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/lfric/lfric_2012-04-09_00.00.00.nc \
      &OUTPUT_DIR;/pb2nc/gdas1.20120409.t12z.prepbufr.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_lfric_pressure_levels \
      -ugrid_config ${MET_BASE}/config/UGridConfig_lfric_pressure_levels \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 4
    </param>
    <output>
      <stat>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_LFRIC_PRESSURE_LEVELS_180000L_20120409_180000V.stat</stat>
    </output>
  </test>

  <!--                                    -->
  <!--  N closest faces interpolation     -->
  <!--                                    -->

  <test name="point_stat_ugrid_mpas_npts">
    <exec>&MET_BIN;/point_stat</exec>
    <env>
      <pair><name>BEG_DS</name>         <value>-1800</value></pair>
      <pair><name>END_DS</name>         <value>1800</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_MPAS_NPTS</value></pair>
      <pair><name>CONFIG_DIR</name>     <value>&CONFIG_DIR;</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2025-05-18_12.00.00.9506.OK.nc \
      &DATA_DIR_OBS;/point_obs/gdas1.20250518.t12z.prepbufr_modified.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_mpas_npts \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 1
    </param>
    <output>
      <stat>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_MPAS_NPTS_120000L_20250518_120000V.stat</stat>
    </output>
  </test>

  <test name="grid_stat_ugrid_mpas_smooth">
    <exec>&MET_BIN;/grid_stat</exec>
    <env>
      <pair><name>CLIMO_MEAN_FILE</name> <value>&DATA_DIR_CLIMO;/NCEP_2.5deg/pgba_mean.19590415</value></pair>
      <pair><name>OUTPUT_PREFIX</name>   <value>UGRID_MPAS_SMOOTH</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2012-04-09_12.00.00_reduced.nc \
      &DATA_DIR_UGRID;/mpas/mpasout.2012-04-09_12.00.00_reduced.nc \
      &CONFIG_DIR;/GridStatConfig_ugrid_mpas_smooth \
      -outdir &OUTPUT_DIR;/grid_stat_ugrid -v 1
    </param>
    <output>
      <stat>&OUTPUT_DIR;/grid_stat_ugrid/grid_stat_UGRID_MPAS_SMOOTH_120000L_20120409_120000V.stat</stat>
    </output>
  </test>

  <!-- Unsupported interpolation methods for the unstructured grid -->
  <!-- must be rejected while processing the configuration         -->

  <test name="point_stat_ugrid_mpas_BAD_INTERP">
    <exec>&MET_BIN;/point_stat</exec>
    <retval>1</retval>
    <env>
      <pair><name>BEG_DS</name>         <value>-1800</value></pair>
      <pair><name>END_DS</name>         <value>1800</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_MPAS_BAD_INTERP</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2025-05-18_12.00.00.9506.OK.nc \
      &DATA_DIR_OBS;/point_obs/gdas1.20250518.t12z.prepbufr_modified.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_mpas_bad_interp \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 1
    </param>
    <output>
      <not_exist>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_MPAS_BAD_INTERP_120000L_20250518_120000V.stat</not_exist>
    </output>
  </test>

  <test name="point_stat_ugrid_mpas_BAD_TOPO_INTERP">
    <exec>&MET_BIN;/point_stat</exec>
    <retval>1</retval>
    <env>
      <pair><name>BEG_DS</name>         <value>-1800</value></pair>
      <pair><name>END_DS</name>         <value>1800</value></pair>
      <pair><name>OUTPUT_PREFIX</name>  <value>UGRID_MPAS_BAD_TOPO_INTERP</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2025-05-18_12.00.00.9506.OK.nc \
      &DATA_DIR_OBS;/point_obs/gdas1.20250518.t12z.prepbufr_modified.nc \
      &CONFIG_DIR;/PointStatConfig_ugrid_mpas_bad_topo \
      -outdir &OUTPUT_DIR;/point_stat_ugrid -v 1
    </param>
    <output>
      <not_exist>&OUTPUT_DIR;/point_stat_ugrid/point_stat_UGRID_MPAS_BAD_TOPO_INTERP_120000L_20250518_120000V.stat</not_exist>
    </output>
  </test>

  <test name="grid_stat_ugrid_mpas_BAD_SMOOTH">
    <exec>&MET_BIN;/grid_stat</exec>
    <retval>1</retval>
    <env>
      <pair><name>OUTPUT_PREFIX</name>   <value>UGRID_MPAS_BAD_SMOOTH</value></pair>
    </env>
    <param> \
      &DATA_DIR_UGRID;/mpas/diag.2012-04-09_12.00.00_reduced.nc \
      &DATA_DIR_UGRID;/mpas/mpasout.2012-04-09_12.00.00_reduced.nc \
      &CONFIG_DIR;/GridStatConfig_ugrid_mpas_bad_smooth \
      -outdir &OUTPUT_DIR;/grid_stat_ugrid -v 1
    </param>
    <output>
      <not_exist>&OUTPUT_DIR;/grid_stat_ugrid/grid_stat_UGRID_MPAS_BAD_SMOOTH_120000L_20120409_120000V.stat</not_exist>
    </output>
  </test>

</met_test>
