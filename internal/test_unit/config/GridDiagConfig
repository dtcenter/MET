      },
      {
         name   = "PWAT";
         level  = ["L0"];
         n_bins = 80;
         range  = [0, 80]; // kg/m^2
      }
   ];
}

////////////////////////////////////////////////////////////////////////////////

//
// Geographic masking regions
//
mask = {
   grid = [ "FULL", "DTC165", "DTC166" ];
   poly = [];
}

