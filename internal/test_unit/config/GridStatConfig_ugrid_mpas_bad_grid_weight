////////////////////////////////////////////////////////////////////////////////
//
// Grid-Stat configuration file.
//
// For additional information, please see the MET User's Guide.
//
// Negative test: grid_weight_flag = AREA requires the face area
// (area_face), which UGridConfig_mpas_no_area does not define.
// Grid-Stat should exit with an error when computing the grid weights.
//
////////////////////////////////////////////////////////////////////////////////

model = "MPAS";

regrid = {
   to_grid = NONE;
}

fcst = {
   field = [
      { name = "temperature";  level = "P925"; }
   ];
}
obs = {
   field = [
      { name = "theta";  level = "L3"; }
   ];
}

output_flag = {
   sl1l2 = STAT;
}

nc_pairs_flag = FALSE;

grid_weight_flag = AREA;

output_prefix = "${OUTPUT_PREFIX}";

ugrid_dataset = "${MET_TEST_BASE}/config/UGridConfig_mpas_no_area";
ugrid_coordinates_file = "${MET_TEST_INPUT}/ugrid_data/mpas/static.40962_reduced.nc";

////////////////////////////////////////////////////////////////////////////////
