model = "MPAS";

regrid = {
   to_grid = NONE;
}

fcst = {
   field = [
      { name = "temperature";  level = "P925"; }
   ];
}
obs = {
   field = [
      { name = "theta";  level = "L3"; }
   ];
}

output_flag = {
   sl1l2  = STAT;
   nbrcnt = STAT;
}

nc_pairs_flag = FALSE;

output_prefix = "${OUTPUT_PREFIX}";

ugrid_dataset = "mpas";
ugrid_coordinates_file = "${MET_TEST_INPUT}/ugrid_data/mpas/static.40962_reduced.nc";

