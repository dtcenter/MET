////////////////////////////////////////////////////////////////////////////////
//
// Grid-Stat configuration file.
//
// For additional information, please see the MET User's Guide.
//
// Negative test: GAUSSIAN smoothing is not supported on the unstructured grid.
// Grid-Stat should exit with an error after determining the verification grid.
//
////////////////////////////////////////////////////////////////////////////////

model = "MPAS";

regrid = {
   to_grid = NONE;
}

fcst = {
   field = [
      { name = "temperature";  level = "P925"; }
   ];
}
obs = {
   field = [
      { name = "theta";  level = "L3"; }
   ];
}

interp = {
   field      = BOTH;
   vld_thresh = 1.0;
   type = [
      { method = GAUSSIAN; width = 1; }
   ];
}

output_prefix = "${OUTPUT_PREFIX}";

ugrid_dataset = "mpas";
ugrid_coordinates_file = "${MET_TEST_INPUT}/ugrid_data/mpas/static.40962_reduced.nc";

////////////////////////////////////////////////////////////////////////////////
