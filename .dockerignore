# Keep locally-built artifacts out of the Docker build context.
#
# internal/scripts/docker/Dockerfile.copy does "COPY . ${MET_REPO_DIR}", so
# without this file a local (e.g. macOS) build tree leaks into the Linux image.
# The local .o/.a files are newer than their sources, so make inside the
# container considers them up to date and tries to link foreign objects.
# This also cuts the build context down substantially.

# git metadata - Dockerfile.copy sets MET_GIT_NAME from SOURCE_BRANCH
**/.git

# compiled objects and static libraries
**/*.o
**/*.a
**/*.lo
**/*.la
**/.deps
**/.libs
**/*.dSYM

# autotools output - ./bootstrap and ./configure regenerate all of these.
# docs/Makefile and scripts/Makefile are hand-written and tracked in git -
# configure only generates scripts/Rscripts/Makefile - so keep those two.
**/Makefile
!docs/Makefile
!scripts/Makefile
**/config.h
**/config.log
**/config.status
**/stamp-h1
**/autom4te.cache

# install trees - regenerated by make install
bin
share

# NOTE: do NOT exclude out/ - "make test" writes into out/<tool>/ and those
# directories are created in git by tracked .gitignore placeholder files.
# A "out/**" + "!out/**/.gitignore" pair does NOT preserve them: Docker drops
# the directories entirely and the sample scripts then fail with
# "can't open the output file ... for writing".

# local SonarQube scan exports
sonarqube_findings_develop.*

# editor and OS noise
**/*~
**/*#*#
**/.DS_Store
**/__pycache__
**/.idea
